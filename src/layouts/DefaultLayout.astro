---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = "Luna Consulting | Non-Profit Strategy & Governance",
  description = "Expert strategic planning, governance reviews, and impact measurement for non-profit organisations in Ireland and internationally.",
  image = "/og-homepage.png",
  type = "website",
} = Astro.props;

const siteUrl = Astro.site?.toString() || "https://lunaconsulting.ie";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Site is indexed -->
    <meta name="robots" content="index, follow" />

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="/fonts/SortsMillGoudy-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GoudyBookletter1911.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/HankenGrotesk-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Luna Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Favicons -->
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/favicon/favicon-48x48.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon/favicon-96x96.png"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />

    <!-- Apple / iOS -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Luna Consulting" />

    <!-- PWA / Android -->
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#2c5378" />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Luna Atkins Romero Consulting",
        description:
          "Strategic planning, governance, and impact measurement for non-profit organisations",
        url: siteUrl,
        founder: {
          "@type": "Person",
          name: "Luna Atkins Romero",
          jobTitle: "Non-Profit Consultant",
        },
        address: {
          "@type": "PostalAddress",
          addressCountry: "IE",
        },
        areaServed: ["IE", "GB", "Worldwide"],
        serviceType: [
          "Strategic Planning",
          "Governance Review",
          "Impact Measurement",
          "Board Evaluation",
        ],
        email: "hello@lunaconsulting.ie",
      })}
    />
  </head>

  <body>
    <slot />
  </body>
</html>
