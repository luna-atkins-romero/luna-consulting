---
import { getCollection, type CollectionEntry } from 'astro:content';
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WavyDivider from '../../components/WavyDivider.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post: CollectionEntry<'articles'>) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'articles'>;
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<DefaultLayout title={post.data.title}>
  <Header />

  <article class="py-16 px-6 bg-theme-bg-neutral1">
    <div class="max-w-4xl mx-auto article-container">
      
      <!-- Article Header -->
      <header class="mb-12">
        <h1 class="heading-section text-5xl md:text-6xl text-theme-text-dark">
          {post.data.title}
        </h1>
        <time class="article-meta" datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </header>

      <!-- Article Body -->
      <div class="article-body">
        <Content />
      </div>

      <!-- Back Link -->
       <div class="article-divider">
        <WavyDivider />
       </div>
      
      <div>
        <a href="/articles" class="link-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg);">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          Back to Articles
        </a>
      </div>
      
    </div>
  </article>

  <Footer />
</DefaultLayout>