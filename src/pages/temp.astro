---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import LinkedInIcon from "../components/LinkedInIcon.astro";
---

<DefaultLayout>
  <!-- Navbar -->
  <Header />
  <!-- Landing Section -->
  <section
    class="flex-grow flex items-center py-16 px-6 bg-theme-main text-theme-text-light"
  >
    <div class="max-w-4xl mx-auto">
      <h1 class="heading-section text-6xl md:text-8xl">
        Let's work together<span
          class="text-theme-accent"
          style="display:  inline-block; line-height:  1.1;">.</span
        >
      </h1>
    </div>
  </section>

  <section class="py-16 px-6 bg-theme-bg">
    <div class="max-w-4xl mx-auto">
      <!-- Message + Connect Columns -->
      <div class="grid md:grid-cols-2 gap-24">
        <!-- Contact Form -->
        <div>
          <h2 class="heading-alt text-2xl md:text-3xl text-theme-main mb-8">
            Send me a message
          </h2>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-6"
          >
            <input
              type="hidden"
              name="access_key"
              value="07207747-177e-49e6-93ed-ceb2af8654c1"
            />

            <div>
              <label for="name">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="organisation">Organisation</label>
              <input
                type="text"
                id="organisation"
                name="organisation"
                placeholder="Your organisation"
              />
            </div>

            <div>
              <label for="message">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                placeholder="Tell me about your project..."></textarea>
            </div>

            <button type="submit">Send message</button>
          </form>
        </div>

        <!-- Connect -->
        <!-- <div class="flex flex-col align-center"> -->


          <div class="flex flex-col align-center space-y-12">
            <!-- Email -->
            <div class="connect-card">
              <div class="icon-circle">
                <Icon aria-hidden="true" name="lucide:mail" />
              </div>
              <div>
                <h3 class="text-theme-main mb-2">Email me</h3>
                <p class="text-theme-main mb-3">hello@luncaconsulting.ie</p>
              </div>
            </div>
            <!-- LinkedIn -->
            <div class="connect-card">
              <div class="icon-circle-link">
                <a
                  href="https://www.linkedin.com/in/lunaatkinsromero/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn profile"
                  class="inline-flex items-center hover:opacity-80 transition-opacity"
                >
                  <LinkedInIcon />
                </a>
              </div>
              <div>
                <h3 class="text-theme-main mb-2">LinkedIn</h3>
                <p class="text-theme-main mb-3">
                  Connect with me professionally.
                </p>
                <a
                  href="https://www.linkedin.com/in/lunaatkinsromero/"
                  target="_blank"
                  rel="noopener
                noreferrer"
                  class="link-arrow"
                >
                  View Profile
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Based in Ireland -->
            <div class="connect-card">
              <div class="icon-circle">
                <Icon aria-hidden="true" name="lucide:map-pin" />
              </div>
              <div>
                <h3 class="text-theme-main mb-2">Based in Ireland</h3>
                <p class="text-theme-main mb-3">
                  Working with organisations locally, nationally and
                  internationally.
                </p>
              </div>
            </div>

          </div>

        </div>

      <!-- </div> -->

    </div><!--END Message + Connect Columns -->
  </section>
</DefaultLayout>

<!-- Footer -->
<Footer />
