<!-- About Section -->
<section id="about" class="py-16 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Heading + wavy divider -->
    <div class="mb-12 text-center">
      <h2 class="font-headline text-4xl md:text-5xl text-dusk-blue mb-4">
        About Me
      </h2>
      <svg
        class="mx-auto w-24 h-2"
        viewBox="0 0 100 10"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,5 Q5,0 10,5 T20,5 T30,5 T40,5 T50,5 T60,5 T70,5 T80,5 T90,5 T100,5"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          class="text-dusk-blue"
        />
      </svg>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-12">
      <!-- Text -->
      <div class="md:flex-1 space-y-4">
        <p class="text-lg text-gray-800 leading-relaxed">
          I have dedicated my career to working with and for mission-driven organisations.
        </p>
        <p class="text-lg text-gray-800 leading-relaxed">
          My academic and professional background is in the social sciences, particularly equality, gender justice, human rights, and international development.
        </p>
        <p class="text-lg text-gray-800 leading-relaxed">
          I am passionate about the role of the non-profit sector in bringing about social and economic justice.
        </p>
      </div>

      <!-- Profile Image -->
      <div class="md:flex-1 flex justify-center md:justify-end">
        <div class="w-64 h-64 rounded-full overflow-hidden border-4 border-dusk-blue">
          <img
            src="/images/luna-portrait.jpg"
            alt="Luna Atkins Romero"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Experience Section -->
<section id="experience" class="py-16 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <h3 class="font-headline text-3xl text-dusk-blue mb-8 text-center">Experience</h3>
    <p class="text-gray-700 text-center mb-12">
      Over the last 20 years, I have worked with and for a range of mission-driven organisations.
    </p>

    <!-- Logos Grid -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 items-center justify-items-center">
      <!-- Use SVG for logos where possible; fallback to WebP/PNG -->
      <img src="/logos/logo1.svg" alt="Amnesty International" class="max-h-16 object-contain">
      <img src="/logos/logo2.svg" alt="Goal" class="max-h-16 object-contain">
      <img src="/logos/logo3.svg" alt="UNICEF" class="max-h-16 object-contain">
      <img src="/logos/logo4.webp" alt="GNB" class="max-h-16 object-contain">
      <img src="/logos/logo5.png" alt="KCYS" class="max-h-16 object-contain">
    </div>
  </div>
</section>

