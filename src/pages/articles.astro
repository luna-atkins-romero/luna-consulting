---
import { getCollection } from 'astro:content';
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import WavyDivider from '../components/WavyDivider.astro';
import Footer from "../components/Footer.astro";

const posts = await getCollection('articles');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<DefaultLayout title="Articles | Luna Atkins Romero">
  <Header />
  <main id="main-content">  

  <!-- Hero Section -->
  <section class="flex-grow flex items-center py-16 px-6 bg-theme-bg-primary-blue text-theme-text-light">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="heading-section text-6xl md:text-8xl">
        Insights and thoughts on
        <span class="word-unit">
        non<span class="text-theme-accent">-</span>profit
        </span>
        <span class="word-unit">strategy<span class="text-theme-accent">,</span>
        </span>
          governance and
        <span class="word-unit">
          impact<span class="text-theme-accent font-oversize">.</span>
        </span>
      </h1> 
    </div>
  </section>

  <!-- Articles Section -->
  <section class="py-16 px-6 bg-theme-bg-neutral1">
    <div class="max-w-4xl mx-auto">

      <div class="space-y-6">
        {sortedPosts.map((post) => (
          <article class="article-card">
            <a href={`/articles/${post.slug}`} tabindex="-1">
              <h2 class="article-card-title">
                {post.data.title}
              </h2>
            </a>
            <time class="article-card-date" datetime={post.data.date.toISOString()}>
              Published: {post.data.date.toLocaleDateString('en-IE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <p class="article-card-description">
              {post.data.description}
            </p>
            <a href={`/articles/${post.slug}`} class="link-arrow" aria-label={`Read article: ${post.data.title}`}>
              Read Article
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </article>
          <div class="wavy-divider mb-12">
            <WavyDivider />
          </div>
          
        ))}
      </div>
       
    </div>
   
  </section>

  </main>
  <Footer />
</DefaultLayout>