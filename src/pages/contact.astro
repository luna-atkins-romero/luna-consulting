---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
---

<DefaultLayout>
  <!-- Navbar -->
 <Header />

  <!-- Contact Section -->
  <section class="py-32 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-16">
        <h1 class="font-headline text-4xl md:text-5xl text-dusk-blue mb-6">
          Let's work together
        </h1>
        <p class="text-xl text-gray-700 leading-relaxed">
          Get in touch to discuss how I can support your organisation's mission and goals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Contact Form -->
        <div>
          <h2 class="font-headline text-2xl text-dusk-blue mb-6">
            Send a message
          </h2>
          
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-6"
          >
            <!-- Replace with your access key from web3forms.com -->
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-medium text-dusk-blue mb-2">
                Name <span class="text-blue-rich">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-rich transition-colors"
                placeholder="Your name"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-dusk-blue mb-2">
                Email <span class="text-blue-rich">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-rich transition-colors"
                placeholder="your@email.com"
              />
            </div>

            <!-- Organisation -->
            <div>
              <label for="organisation" class="block text-sm font-medium text-dusk-blue mb-2">
                Organisation
              </label>
              <input
                type="text"
                id="organisation"
                name="organisation"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-rich transition-colors"
                placeholder="Your organisation"
              />
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-medium text-dusk-blue mb-2">
                Message <span class="text-blue-rich">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-rich transition-colors resize-none"
                placeholder="Tell me about your project or challenge..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-8 py-4 bg-blue-rich hover:bg-dusk-blue text-white font-medium rounded-lg transition-colors"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Information -->
        <div>
          <h2 class="font-headline text-2xl text-dusk-blue mb-6">
            Other ways to connect
          </h2>

          <div class="space-y-6">
            <!-- LinkedIn -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-blue-rich/10 flex items-center justify-center flex-shrink-0">
                <svg
                  class="w-5 h-5 text-blue-rich"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037
                   -1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046
                   c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z
                   M5.337 7.433c-1.144 0-2.063-.926-2.063-2.065
                   0-1.138.92-2.063 2.063-2.063
                   1.14 0 2.064.925 2.064 2.063
                   0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z
                   M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542
                   C0 23.227.792 24 1.771 24h20.451
                   C23.2 24 24 23.227 24 22.271V1.729
                   C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-accent text-lg text-dusk-blue mb-2 font-semibold">
                  LinkedIn
                </h3>
                <p class="text-gray-700 mb-3 leading-relaxed">
                  Connect with me professionally and see my latest updates.
                </p>
                <a
                  href="https://linkedin.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-rich hover:text-dusk-blue font-medium inline-flex items-center gap-2 transition-colors"
                >
                  View Profile</a>
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17L17 7"/>
                    <path d="M7 7h10v10"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Response Time -->
            <div class="pt-6 border-t border-gray-200">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-rich/10 flex items-center justify-center flex-shrink-0">
                  <svg
                    class="w-5 h-5 text-blue-rich"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-accent text-lg text-dusk-blue mb-2 font-semibold">
                    Response Time
                  </h3>
                  <p class="text-gray-700 leading-relaxed">
                    I aim to respond to all enquiries within 48 hours during business days.
                  </p>
                </div>
              </div>
            </div>

            <!-- Working With -->
            <div class="pt-6 border-t border-gray-200">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-blue-rich/10 flex items-center justify-center flex-shrink-0">
                  <svg
                    class="w-5 h-5 text-blue-rich"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-accent text-lg text-dusk-blue mb-2 font-semibold">
                    Based in Ireland
                  </h3>
                  <p class="text-gray-700 leading-relaxed">
                    Working with organisations locally and internationally.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-32 px-6 bg-dusk-blue text-white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg leading-relaxed opacity-90">
        © 2025 Luna Atkins Romero. All rights reserved.
      </p>
    </div>
  </footer>
</DefaultLayout>