---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import LinkedInIcon from "../components/LinkedInIcon.astro";
---

<DefaultLayout>
  <Header />
  <main id="main-content">
    <!-- Landing Section -->
    <section
      class="flex-grow flex items-center py-16 px-6 bg-theme-bg-primary-blue text-theme-text-light"
    >
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="heading-section text-6xl md:text-8xl">
          <span class="word-unit">
            Let<span class="text-theme-accent">'</span>s work together<span
              class="text-theme-accent font-oversize">.</span
            >
          </span>
        </h1>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-16 px-6 bg-theme-bg-neutral1">
      <div class="max-w-4xl mx-auto">
        <!-- Card Container -->
        <div class="in-page-container" style="padding: 4rem;">
          <!-- Based in Ireland -->
          <div class="mb-18">
            <div class="flex items-center justify-center gap-3">
              <Icon
                name="lucide:map-pin"
                class="w-7 h-7 text-theme-accent-coral"
              />
              <h2
                class="heading-alt text-2xl md:text-3xl text-theme-text-dark no-mb"
              >
                Based in Ireland
              </h2>
            </div>
            <p class="text-theme-text-dark text-center my-4">
              Working locally, nationally and internationally.
            </p>
          </div>

          <!-- Two Column Layout  -->
          <div class="flex flex-col-reverse md:grid md:grid-cols-2 gap-8 mt-12">
            <!-- Left Column: Contact Form -->
            <div>
              <h2
                class="heading-alt text-2xl md:text-3xl text-theme-text-dark text-center"
              >
                Send me a message
              </h2>

              <form
                action="https://api.web3forms.com/submit"
                method="POST"
                class="space-y-6"
              >
                <input
                  type="hidden"
                  name="access_key"
                  value="07207747-177e-49e6-93ed-ceb2af8654c1"
                />

                <div>
                  <label for="name">Name *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Your name"
                  />
                </div>

                <div>
                  <label for="email">Email *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="your@email.com"
                  />
                </div>

                <div>
                  <label for="organisation">Organisation</label>
                  <input
                    type="text"
                    id="organisation"
                    name="organisation"
                    placeholder="Your organisation (optional)"
                  />
                </div>

                <div>
                  <label for="message">Message *</label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="6"
                    placeholder="Tell me about your project or challenge..."
                  ></textarea>
                </div>

                <button type="submit" class="submit-button">
                  <span>Send message</span>
                  <Icon name="lucide:send" />
                </button>
              </form>
            </div>

            <!-- Right Column: Connect -->
            <div class="flex flex-col items-center">
              <h2
                class="heading-alt text-2xl md:text-3xl text-theme-text-dark text-center"
              >
                Connect with me
              </h2>

              <!-- Email + LinkedIn items-->
              <div class="flex flex-col items-start gap-12 mt-7">
                <!-- Email - icon + text in row -->
                <div class="flex gap-4">
                  <div
                    class="icon-circle-link flex-shrink-0 text-theme-accent-coral"
                    
                  >
                    <a href="mailto:hello@lunaconsulting.ie" tabindex="-1" aria-label="Email icon">
                      <Icon name="lucide:mail" />
                    </a>
                  </div>
                  <div class="flex flex-col gap-2">
                    <h3 class="text-theme-text-dark text-lg font-medium">
                      Email
                    </h3>
                    <a
                      href="mailto:hello@lunaconsulting.ie"
                      class="link-arrow"
                      aria-label="Email hello at luna consulting dot i e"
                    >
                      hello@lunaconsulting.ie
                    </a>
                  </div>
                </div>

                <!-- LinkedIn - icon + text in row -->
                <div class="flex gap-4">
                  <div
                    class="icon-circle-link flex-shrink-0 text-theme-text-dark"
                  >
                    <a
                      href="https://www.linkedin.com/in/lunaatkinsromero/"
                      target="_blank"
                      rel="noopener noreferrer"
                      tabindex="-1"
                      aria-label="LinkedIn icon"
                    >
                      <LinkedInIcon />        
                    </a>
                  </div>
                  <div class="flex flex-col gap-2">
                    <h3 class="text-theme-text-dark text-lg font-medium">
                      LinkedIn
                    </h3>
                    <a
                      href="https://www.linkedin.com/in/lunaatkinsromero/"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-arrow"
                      aria-label="Connect on LinkedIn (opens in new tab)"
                    >
                      Connect with me
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                </div>
              </div><!-- END Email + LinkedIn items-->
            </div><!-- END Right Column: Connect -->
          </div>
        </div>
        <!-- END Card Container -->
      </div>
    </section>
  </main>
  <Footer />
</DefaultLayout>
