---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<DefaultLayout>
  <!-- Navbar -->
  <Header />
  <!-- Landing Section -->
  <section class="flex-grow flex items-center py-16 px-6 bg-theme-main text-theme-text-light">
    <div class="max-w-4xl mx-auto">
      <h1 class="heading-section text-6xl md:text-8xl">
        Let's work together<span
          class="text-theme-accent"
          style="display:  inline-block; line-height:  1.1;">.</span
        >
      </h1>
    </div>
  </section>

  <!-- Contact Form Section - Light Background -->
  <section class=" py-16 px-6 bg-theme-bg">
    <div class="max-w-4xl mx-auto">

      <!-- Message + Connect Columns -->
      <div class="grid md:grid-cols-2 gap-24">
        
        <!-- Contact Form -->
        <div>
          <h2 class="heading-alt text-2xl md:text-3xl text-theme-main mb-8">
            Send a message
          </h2>

          <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />

  <div>
    <label for="name">Name *</label>
    <input type="text" id="name" name="name" required placeholder="Your name" />
  </div>

  <div>
    <label for="email">Email *</label>
    <input type="email" id="email" name="email" required placeholder="your@email.com" />
  </div>

  <div>
    <label for="organisation">Organisation</label>
    <input type="text" id="organisation" name="organisation" placeholder="Your organisation" />
  </div>

  <div>
    <label for="message">Message *</label>
    <textarea id="message" name="message" required rows="6" placeholder="Tell me about your project..."></textarea>
  </div>

  <button type="submit">Send Message</button>
</form>
        </div>

        <!-- Connect -->
        <div>
          <h2 class="heading-alt text-2xl text-theme-main mb-8">
            Other ways to connect
          </h2>

          <div class="space-y-12">
            <!-- LinkedIn -->
            <div class="connect-card">
              <div
                class="connect-card-icon"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037
                   -1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046
                   c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z
                   M5.337 7.433c-1.144 0-2.063-.926-2.063-2.065
                   0-1.138.92-2.063 2.063-2.063
                   1.14 0 2.064.925 2.064 2.063
                   0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z
                   M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542
                   C0 23.227.792 24 1.771 24h20.451
                   C23.2 24 24 23.227 24 22.271V1.729
                   C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="text-theme-main mb-2">LinkedIn</p>
                <p class="mb-3">
                  Connect with me professionally.
                </p>
                <a
                  href="https://linkedin.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-theme-main/80 hover:text-theme-main inline-flex items-center gap-2 transition-colors"
                >
                  View Profile
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Response Time -->
            <div class="connect-card">
              <div
                class="connect-card-icon"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div>
                <h5 class="text-theme-main mb-2">Response Time</h5>
                <p class="text-gray-700">
                  I aim to respond to all enquiries within 48 hours during
                  business days.
                </p>
              </div>
            </div>

            <!-- Based in Ireland -->
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 rounded-full bg-blue-rich/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-5 h-5 text-blue-rich"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                  ></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>

              <div>
                <h5 class="text-theme-main mb-2">Based in Ireland</h5>
                <p class="text-gray-700">
                  Working with organisations locally and internationally.
                </p>
              </div>
            </div>

          </div>
        </div> <!-- END Connect --> 
      
      </div><!--END Message + Connect Columns -->

    </div> 
  </section>

  <!-- Footer -->
  <Footer />
</DefaultLayout>
