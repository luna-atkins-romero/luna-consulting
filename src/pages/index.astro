---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import LinkedInIcon from "../components/LinkedInIcon.astro";
import WavyDivider from "../components/WavyDivider.astro";
import ServiceCard from "../components/ServiceCard.astro";
import HowIWorkItem from "../components/HowIWorkItem.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Footer from "../components/Footer.astro";

import { Icon } from "astro-icon/components";

import { Image } from "astro:assets";
import luna from "../assets/images/luna-portrait-framed.webp";
import logoGNB from "../assets/logos/gnb.png";
import logoUnicef from "../assets/logos/unicef.png";
import logoAmnesty from "../assets/logos/amnesty.png";
import logoKCYS from "../assets/logos/kcys.png";
import logoGOAL from "../assets/logos/goal.png";
---

<DefaultLayout>
  <!-- Navbar + Hero - Full viewport -->
  <section
    class="min-h-screen bg-theme-main text-theme-text-light flex flex-col"
  >
    <!-- Header -->
    <Header />

    <!-- Hero -->
    <div class="flex-grow flex items-center px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="hero-section text-theme-text-light">
          Strengthening
          <span class="word-unit">
            non<span class="text-theme-accent font-punctuation">-</span>profits
          </span>
          in collaboration with their
          <span class="word-unit">
            teams<span class="text-theme-accent font-punctuation">,</span>
          </span>
          leaders and
          <span class="word-unit">
            communities<span class="text-theme-accent font-punctuation-oversize"
              >.</span
            >
          </span>
        </h1>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section id="intro" class="py-12 px-6 bg-theme-bg">
    <div class="max-w-5xl mx-auto">
      <!-- Outer container: stacks vertically on mobile, horizontally on desktop -->
      <div class="flex flex-col md:flex-row gap-8 md:gap-8 items-center mb-8">
        <!-- Left: Image -->
        <div class="flex-shrink-0 w-56 sm:w-64 md:w-72">
          <Image
            src={luna}
            alt="Luna Atkins Romero Portrait"
            width={512}
            height={494}
            class="w-full h-auto"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Right: Quote + Text (always in a row) -->
        <div class="flex flex-row items-start gap-2 md:gap-4">
          <!-- Quote mark -->
          <div class="quotes-single text-theme-accent flex-shrink-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 70 54"
              role="img"
              aria-hidden="true"
            >
              <path
                d="M68.7 4.614c0 2.16-1.555 4.09-3.734 4.475-3.268.617-6.459 2.006-9.571 4.244-4.28 3.01-6.458 6.714-6.458 11.112 0 4.012 3.812 3.858 6.847 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849-8.949-10.88-5.836-30.635 4.124-39.894 4.746-4.399 10.271-7.1 16.652-8.257 2.723-.54 5.29 1.698 5.29 4.476zm-37.349 0c0 2.16-1.556 4.09-3.735 4.475-3.268.617-6.458 2.006-9.57 4.244-4.28 3.01-6.46 6.714-6.46 11.112 0 4.012 3.813 3.858 6.848 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849C-3.665 37.33-.552 17.577 9.408 8.318 14.154 3.919 19.679 1.218 26.06.06c2.723-.463 5.291 1.775 5.291 4.553z"
                fill="currentColor"></path>
            </svg>
          </div>

          <!-- Text content -->
          <div class="flex flex-col gap-6 items start">
            <!-- Statement -->
            <h2 class="font-statement text-theme-text-dark">
              I have dedicated my career to working with and for mission-driven
              organisations.
            </h2>

            <!-- Bio paragraph -->
            <p class="text-lg text-theme-text-dark leading-relaxed">
              Over the last 20 years, I have worked with mission-driven
              organisations as an employee, consultant, and Charity Trustee -
              bringing 360° lived experience of the non-profit sector. My
              expertise spans strategic planning, governance, impact
              measurement, and organisational development.
            </p>

            <div class="flex flex-row gap-6">       
              <a
                href="#about"
                class="action-button text-lg text-theme-main border-theme-main bg-transparent hover:bg-theme-accent"
              >
                About me
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="pt-12 pb-24 px-6 bg-theme-bg">
    <div class="max-w-6xl mx-auto">
      <!-- Testimonials Grid - Responsive -->
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <TestimonialCard
          quote="The Board, staff team and community loved working with Luna on our Strategic Plan. She made us feel comfortable and guided us through the process, and kept us focused and on track. It was a pleasure to work with Luna and I would highly recommend her."
          name="Jackie Landers"
          title="CEO Listowel Family & Community Resource Centre"
          initials="JL"
        />

        <TestimonialCard
          quote="Luna is extremely skilled at facilitating strategic planning with organisations and groups. I found her openness, perceptiveness and keen insights invaluable throughout. With her support, we achieved a strategic plan that was both ambitious and realisable. No mean feat !!"
          name="Berni Smyth"
          title="Former CEO, Kerry Community Youth Service"
          initials="BS"
        />

        <TestimonialCard
          quote="Her candid feedback and empowering methodology helped our team build the confidence and capacity we needed to take our mission to the next level."
          name="Aisha Johnson"
          title="CEO, Community Impact Group"
          initials="AJ"
        />
      </div>
    </div>
  </section>

  <!-- Services Cards -->
  <section id="services" class="pt-12 pb-24 px-6 bg-theme-bg-dark-green">
    <div class="max-w-6xl mx-auto">
      <div class="mb-18">
        <h2 class="heading-section text-theme-bg mb-2">
          How can I help you?
        </h2>
        <WavyDivider color="var(--color-theme-accent-red)" />
      </div>

      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Cards 1-3 -->
        <ServiceCard title="Strategic planning" icon="lucide:compass">
          Define your strategic vision, priorities and targets, informed by
          contextual analysis and stakeholder input.
        </ServiceCard>

        <ServiceCard
          title="Strategic evaluations and reviews"
          icon="lucide:clipboard-check"
        >
          Develop an evidence-based assessment of your recent successes and
          set-backs, to inform future action.
        </ServiceCard>

        <ServiceCard
          title="Impact definition and measurement"
          icon="lucide:target"
        >
          Strengthen your organisation’s ability to tell the story of its impact
          by defining and measuring change.
        </ServiceCard>

        <!-- Cards 4-6 -->
        <ServiceCard title="Organisational design" icon="lucide:circle-pile">
          Ensure your organisation's structure and capacity are fit-for-purpose
          for delivering your mission and strategy.
        </ServiceCard>

        <ServiceCard title="Board evaluations" icon="lucide:users-round">
          Independent and objective insights to strengthen your Board’s
          leadership, accountability and decision-making.
        </ServiceCard>

        <ServiceCard
          title="Governance reviews and upgrades"
          icon="lucide:clipboard-list"
        >
          Identify opportunities to strengthen your governance policies,
          practices and structures towards best practice.
        </ServiceCard>

        <!-- Cards 7-9 -->

        <ServiceCard
          title="Horizon scanning and market analysis"
          icon="lucide:binoculars"
        >
          Identify emerging trends, risks and opportunities to position you for
          future success.
        </ServiceCard>

        <ServiceCard
          title="Stakeholder and community consultations"
          icon="lucide:message-circle"
        >
          Tailored engagement with your stakeholders to help you understand and
          respond to their needs, experiences and expectations.
        </ServiceCard>

        <ServiceCard
          title="Mentoring and strategic advice"
          icon="lucide:lightbulb"
        >
          One-to-one support for leaders navigating complex organisational
          challenges.
        </ServiceCard>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="pt-12 pb-24 px-6 bg-theme-bg">
    <div class="max-w-5xl mx-auto">
      <!-- Constrain with centering -->
      <div class="max-w-4xl mx-auto">
        <!-- Passionate Statement as Subheading -->
        <h2
          class="heading-section text-theme-text-dark text-center mb-12 leading-relaxed"
        >
          I am passionate about the role of the non-profit sector in bringing
          about social and economic justice.
        </h2>

        <!-- About text -->
        <div class="max-w-3xl mx-auto text-theme-text-dark space-y-6 mb-12">
          <p>
            Charities, NGOs, social enterprises, research and advocacy
            organisations, and social movements play a vital role in championing
            and addressing people's needs where the state or the economy have
            failed them. <span class="para-emphasis"
              >I am committed to applying my skills and experience to enable
              them to do so more effectively and efficiently</span
            >
            .
          </p>

          <p>
            My academic and professional background is in the social sciences,
            particularly equality, gender justice, human rights and
            international development. <span class="para-emphasis"
              >I've worked with individual change-makers, organisations and
              networks spanning a huge diversity of social sectors and issues
              nationally and internationally</span
            >.
          </p>

          <p>
            Over the last 20 years, I have garnered <span class="para-emphasis"
              >360° lived experience of non-profits</span
            >: as an employee and manager within the sector, as a consultant to
            the sector, and as a Charity Trustee.
          </p>
        </div>

        <!-- Logos Grid -->
        <div>
          <h3 class="text-theme-text-dark text-center mt-18 mb-12">
            A sample of the organisations I've worked with, and for:
          </h3>
          <div
            class="grid grid-cols-2 md:grid-cols-5 gap-6 items-center justify-items-center"
          >
            <Image
              src={logoGNB}
              alt="Girls not Brides Charity Logo"
              class="work-logo max-h-16 object-contain"
            />
            <Image
              src={logoUnicef}
              alt="UNICEF UK Charity Logo"
              class="work-logo max-h-20 object-contain"
            />
            <Image
              src={logoAmnesty}
              alt="Amnesty International Charity Logo Banner"
              class="work-logo max-h-16 object-contain"
            />
            <Image
              src={logoKCYS}
              alt="Kerry Community Youth Services Charity Logo"
              class="work-logo max-h-24 object-contain"
            />
            <Image
              src={logoGOAL}
              alt="GOAL Charity Logo"
              class="work-logo max-h-16 object-contain"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

   <!-- How I work -->
  <section id="how-i-work" class="py-36 bg-theme-main-darker">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Section Heading -->
      <h2 class="heading-section text-center text-theme-text-light mb-24">
        How I work
      </h2>

      <!-- Icons Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-18 items-start"
      >
        <HowIWorkItem
          title="Collaborative"
          description="Co-creating solutions alongside teams to ensure ownership and practical outcomes."
          icon="lucide:handshake"
        />
        <HowIWorkItem
          title="Empowering"
          description="Building capacity, confidence, and resilience within organisations."
          icon="lucide:mountain"
        />
        <HowIWorkItem
          title="Analytical"
          description="Evidence-led insight that informs practical strategy and decision-making."
          icon="lucide:gauge"
        />
        <HowIWorkItem
          title="Candid"
          description="Honest, clear guidance rooted in real-world experience."
          icon="lucide:message-square-quote"
        />
      </div>
    </div>
  </section>

  <!-- Contact / Footer -->
  <Footer />
</DefaultLayout>
