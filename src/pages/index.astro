---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Navigation from "../components/Navigation.astro";
import Brand from "../components/Brand.astro";
---

<DefaultLayout>

  <!-- Navbar + Hero - Full viewport -->
  <section class="min-h-screen bg-navy-deep text-white flex flex-col">
    <!-- Header -->
    <header class="py-8 px-6">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        
        <!-- Brand -->
        <Brand />

        <!-- Nav -->
        <Navigation>
          <li><a href="#services">Services</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
          <li>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
              class="flex items-center gap-2"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037
             -1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046
             c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z
             M5.337 7.433c-1.144 0-2.063-.926-2.063-2.065
             0-1.138.92-2.063 2.063-2.063
             1.14 0 2.064.925 2.064 2.063
             0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z
             M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542
             C0 23.227.792 24 1.771 24h20.451
             C23.2 24 24 23.227 24 22.271V1.729
             C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
          </li>
        </Navigation>

      </div>
    </header>

    <!-- Hero -->
    <div class="flex-grow flex items-center px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-9xl md:text-6xl leading-tight">
          Strengthening non-profits in collaboration with their teams, leaders
          and communities.
        </h1>
      </div>
    </div>

  </section>

</DefaultLayout>

<!-- Services Cards -->
<section id="services" class="py-12 px-6">
  <div class="max-w-5xl mx-auto">
    <h2
      class="text-5xl md:text-5xl text-navy-deep mb-24 text-center py-12"
    >
      How can I help you?
    </h2>
    <div class="grid md:grid-cols-2 gap-12">
      <ServiceCard title="Strategic planning" icon="lucide:compass">
        Supporting organisations to define their vision and create actionable
        roadmaps for sustainable impact.
      </ServiceCard>

      <ServiceCard
        title="Strategic evaluations and reviews"
        icon="lucide:clipboard-list"
      >
        Comprehensive analysis of organisational effectiveness and opportunities
        for improvement.
      </ServiceCard>

      <ServiceCard
        title="Horizon scanning and market analysis"
        icon="lucide:binoculars"
      >
        Identifying emerging trends and opportunities to position your
        organisation for future success.
      </ServiceCard>

      <ServiceCard title="Governance" icon="lucide:shield-check">
        Building robust governance structures that ensure accountability and
        effective decision-making.
      </ServiceCard>

      <ServiceCard title="Organisational design" icon="lucide:layers">
        Creating efficient structures and systems that enable teams to deliver
        their mission effectively.
      </ServiceCard>

      <ServiceCard title="Defining and measuring impact" icon="lucide:target">
        Developing frameworks to track, evaluate and communicate your
        organisation's social impact.
      </ServiceCard>

      <ServiceCard
        title="Stakeholder and community consultations"
        icon="lucide:users"
      >
        Facilitating meaningful engagement with communities and stakeholders to
        inform strategy.
      </ServiceCard>

      <ServiceCard
        title="Mentoring and strategic advice"
        icon="lucide:lightbulb"
      >
        One-to-one support for leaders navigating complex organisational
        challenges.
      </ServiceCard>
    </div>
  </div>
</section>

<!-- About & Approach Combined -->
<!-- About & Approach -->
<section id="about" class="py-32 px-6 bg-blue-light bg-opacity-5">
  <div class="max-w-5xl mx-auto space-y-20">

    <!-- Intro: Profile + Principles -->
    <div class="grid md:grid-cols-[280px_1fr] gap-16 items-start">
      
      <!-- Profile image -->
      <div class="flex justify-center md:justify-start">
        <div
          class="w-64 h-64 rounded-full bg-gradient-to-br from-blue-light to-blue-rich overflow-hidden border-4 border-blue-rich"
        >
          <img
            src="/images/luna-portrait.jpg"
            alt="Luna Atkins Romero"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Approach Values -->
      <div class="space-y-12">
        <h2 class="font-headline text-3xl md:text-4xl text-navy-deep">
          How I work
        </h2>

        <div class="grid sm:grid-cols-2 gap-8">
          <!-- Collaborative -->
          <div class="flex items-start gap-4">
            <div class="text-blue-rich mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 6v6l4 2" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="font-accent text-lg text-navy-deep">Collaborative</p>
              <p class="text-gray-700 text-sm">
                Co-creating solutions alongside teams to ensure ownership and practical outcomes.
              </p>
            </div>
          </div>
          <!-- Empowering -->
          <div class="flex items-start gap-4">
            <div class="text-blue-rich mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 2l9 4.5v9L12 20 3 15.5v-9L12 2z" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="font-accent text-lg text-navy-deep">Empowering</p>
              <p class="text-gray-700 text-sm">
                Building capacity, confidence and resilience within organisations.
              </p>
            </div>
          </div>
          <!-- Analytical -->
          <div class="flex items-start gap-4">
            <div class="text-blue-rich mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 3h18v18H3z" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="font-accent text-lg text-navy-deep">Analytical</p>
              <p class="text-gray-700 text-sm">
                Evidence-led insight that informs practical strategy and decision-making.
              </p>
            </div>
          </div>
          <!-- Candid -->
          <div class="flex items-start gap-4">
            <div class="text-blue-rich mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 12h14" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="font-accent text-lg text-navy-deep">Candid</p>
              <p class="text-gray-700 text-sm">
                Honest, clear guidance rooted in real-world experience.
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- About Narrative -->
    <div class="max-w-3xl space-y-6">
      <h3 class="font-headline text-3xl text-navy-deep">
        About me
      </h3>

      <p class="text-lg text-gray-800 leading-relaxed">
        I have dedicated my career to working with and for mission-driven organisations. Over the last
        20 years, I have garnered 360° lived experience of non-profits: as an employee and manager,
        as a consultant, and as a Trustee.
      </p>

      <p class="text-lg text-gray-800 leading-relaxed">
        My academic and professional background is in the social sciences, particularly equality,
        gender justice, human rights and international development.
      </p>

      <p class="text-lg text-gray-800 leading-relaxed">
        I am passionate about the role of the non-profit sector in bringing about social and economic
        justice.
      </p>
    </div>

  </div>
</section>


<!-- Organizations -->
<section class="py-24 px-6 bg-white border-t border-b border-gray-100">
  <div class="max-w-5xl mx-auto">
    <p class="text-sm uppercase tracking-widest text-gray-500 mb-3">
      Experience
    </p>
    <p class="text-lg text-gray-700">Amnesty, Goal, Unicef, GNB, KCYS</p>
  </div>
</section>

<!-- Testimonials Placeholder -->
<section class="py-32 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="font-headline text-4xl md:text-5xl text-navy-deep mb-16">
      What people say
    </h2>
    <div class="space-y-8">
      <div class="border-l-4 border-blue-rich pl-8">
        <p class="text-lg italic text-gray-700 mb-4">
          [Testimonial placeholder]
        </p>
        <p class="text-sm text-gray-600">— Name, Organization</p>
      </div>
    </div>
  </div>
</section>

<!-- Contact / Footer -->
<footer id="contact" class="py-32 px-6 bg-navy-deep text-white">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="font-headline text-4xl md:text-5xl mb-8">Let's work together</h2>
    <p class="text-lg mb-12 leading-relaxed">
      Connect with me on LinkedIn to discuss how I can support your
      organisation.
    </p>
    <a
      href="https://linkedin.com"
      target="_blank"
      rel="noopener"
      class="inline-block px-8 py-4 bg-blue-rich hover: bg-blue-light transition-colors rounded text-white font-medium"
    >
      View LinkedIn Profile
    </a>
  </div>
</footer>
