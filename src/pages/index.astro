---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Header from "../components/Header.astro";

import WavyDivider from "../components/WavyDivider.astro";
import HowIWorkItem from "../components/HowIWorkItem.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Footer from '../components/Footer.astro';
---

<DefaultLayout>

  <!-- Navbar + Hero - Full viewport -->
  <section class="min-h-screen bg-dusk-blue text-white flex flex-col">
    <!-- Header -->
    <Header />

    <!-- Hero -->
    <div class="flex-grow flex items-center px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="font-hero">
          Strengthening non-profits in collaboration with their teams<span
            class="text-green-aqua"
            style="display: inline-block; line-height: 1.1;">,</span
          > leaders and communities<span
            class="text-green-aqua"
            style="display: inline-block; line-height: 1.1;">.</span
          >
        </h1>
      </div>
    </div>
  </section>

  <!-- Services Cards -->
  <section id="services" class="pt-12 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-18">
        <h2 class="font-headline text-dusk-blue mb-2">How can I help you?</h2>
        <WavyDivider />
      </div>

      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <ServiceCard title="Strategic planning" icon="lucide:compass">
          Supporting organisations to define their vision and create actionable
          roadmaps for sustainable impact.
        </ServiceCard>

        <ServiceCard
          title="Strategic evaluations and reviews"
          icon="lucide:clipboard-list"
        >
          Comprehensive analysis of organisational effectiveness and
          opportunities for improvement.
        </ServiceCard>

        <ServiceCard
          title="Horizon scanning and market analysis"
          icon="lucide:binoculars"
        >
          Identifying emerging trends and opportunities to position your
          organisation for future success.
        </ServiceCard>

        <ServiceCard title="Board evaluations" icon="lucide:clipboard-check">
          Independent board effectiveness reviews to strengthen leadership,
          accountability and decision-making.
        </ServiceCard>

        <ServiceCard
          title="Governance reviews and upgrades"
          icon="lucide:shield-check"
        >
          Reviewing and strengthening governance frameworks, policies and
          structures to meet organisational needs.
        </ServiceCard>

        <ServiceCard title="Organisational design" icon="lucide:layers">
          Creating efficient structures and systems that enable teams to deliver
          their mission effectively.
        </ServiceCard>

        <ServiceCard title="Defining and measuring impact" icon="lucide:target">
          Developing frameworks to track, evaluate and communicate your
          organisation's social impact.
        </ServiceCard>

        <ServiceCard
          title="Stakeholder and community consultations"
          icon="lucide:users"
        >
          Facilitating meaningful engagement with communities and stakeholders
          to inform strategy.
        </ServiceCard>

        <ServiceCard
          title="Mentoring and strategic advice"
          icon="lucide:lightbulb"
        >
          One-to-one support for leaders navigating complex organisational
          challenges.
        </ServiceCard>
      </div>
    </div>
  </section>
  
  <!-- About -->
  <section id="about" class="pt-12 pb-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <!-- About Me Header -->
      <div class="mb-18">
        <h2 class="font-headline text-dusk-blue mb-2">About Me</h2>
        <WavyDivider />
      </div>

      <!-- Constrain with centering -->
      <div class="max-w-5xl mx-auto">
        <!-- Bio with Image -->
        <div class="flex flex-col md:flex-row items-center gap-12">
          <!-- Profile image -->
          <div>
            <div
              class="w-64 h-64 rounded-full overflow-hidden border-3 border-dusk-blue"
            >
              <img
                src="/images/luna-portrait.jpg"
                alt="Luna Atkins Romero"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <!-- About text -->
          <div
            class="text-dusk-blue space-y-6 border-l-3 border-green-aqua pl-6"
          >
            <h2 class="text-dusk-blue font-statement text-3xl md:text-4xl">
              I have dedicated my career to working with and for mission-driven
              organisations.
            </h2>

            <h2 class="font-statement text-xl md:text-2xl">
              My academic and professional background is in the social sciences,
              particularly equality, gender justice, human rights and
              international development.
            </h2>

            <h2 class="font-statement text-xl md:text-2xl">
              I am passionate about the role of the non-profit sector in
              bringing about social and economic justice.
            </h2>

            <h2 class="font-statement text-xl md:text-2xl">
              Over the last 20 years, I have garnered 360° lived experience of
              non-profits: as an employee and manager, as a consultant, and as a
              Trustee.
            </h2>
          </div>
        </div>

        <!-- Logos Grid -->
        <div class="mt-8 pt-8">
          <div
            class="grid grid-cols-2 md:grid-cols-5 gap-6 items-center justify-items-center"
          >
            <img
              src="/logos/gnb.png"
              alt="GNB"
              class="max-h-16 object-contain opacity-[0.7] hover:opacity-[1] transition-opacity duration-300"
            />
            <img
              src="/logos/unicef.png"
              alt="UNICEF"
              class="max-h-20 object-contain opacity-70 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/amnesty.png"
              alt="Amnesty International"
              class="max-h-16 object-contain opacity-70 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/kcys.png"
              alt="KCYS"
              class="max-h-24 object-contain opacity-70 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/goal.png"
              alt="Goal"
              class="max-h-16 object-contain opacity-70 hover:opacity-100 transition-opacity duration-300"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

    <section id="how-i-work" class="pt-12 pb-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <!-- How I Work Header -->
      <div class="mb-18">
        <h2 class="font-headline text-dusk-blue mb-2">How I Work</h2>
        <WavyDivider />
      </div>

      <!-- Constrain with centering -->
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <HowIWorkItem
            title="Collaborative"
            description="Co-creating solutions alongside teams to ensure ownership and practical outcomes."
            icon='<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>'
          />

          <HowIWorkItem
            title="Empowering"
            description="Building capacity, confidence and resilience within organisations."
            icon='<path d="M12 2v20"></path><path d="m15 19-3 3-3-3"></path><path d="m19 9 3 3-3 3"></path><path d="M2 12h20"></path><path d="m5 9-3 3 3 3"></path><path d="m9 5 3-3 3 3"></path>'
          />

          <HowIWorkItem
            title="Analytical"
            description="Evidence-led insight that informs practical strategy and decision-making."
            icon='<line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line>'
          />

          <HowIWorkItem
            title="Candid"
            description="Honest, clear guidance rooted in real-world experience."
            icon='<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>'
          />
        </div>
      </div>
      
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="pt-12 pb-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <!-- Testimonials Header -->
      <div class="mb-18">
        <h2 class="font-headline text-dusk-blue mb-2">Testimonials</h2>
        <WavyDivider />
      </div>

      <!-- Testimonials Grid - Responsive -->
      <div
        class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <TestimonialCard
          quote="Working with Luna transformed our organization's approach to strategic planning. Her insight and collaborative style brought our team together in ways we hadn't experienced before."
          name="Jane Doe"
          title="Executive Director, Sample Charity"
          initials="JD"
        />

        <TestimonialCard
          quote="Luna's analytical approach combined with her deep understanding of the non-profit sector provided exactly the guidance we needed during a critical transition period."
          name="Michael Smith"
          title="Chair, Example Foundation"
          initials="MS"
        />

        <TestimonialCard
          quote="Her candid feedback and empowering methodology helped our team build the confidence and capacity we needed to take our mission to the next level."
          name="Aisha Johnson"
          title="CEO, Community Impact Group"
          initials="AJ"
        />
      </div>

    </div>
  </section>

  <!-- Contact / Footer -->
  <Footer />

</DefaultLayout>
