---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import WavyDivider from "../components/WavyDivider.astro";
import ServiceCard from "../components/ServiceCard.astro";
import HowIWorkItem from "../components/HowIWorkItem.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Footer from "../components/Footer.astro";
---

<DefaultLayout>
  <!-- Navbar + Hero - Full viewport -->
  <section class="min-h-screen bg-theme-main text-light flex flex-col">
    <!-- Header -->
    <Header />

    <!-- Hero -->
    <div class="flex-grow flex items-center px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="hero-section text-theme-text-light">
          Strengthening non<span class="text-theme-accent font-punctuation"
            >-</span
          >profits in collaboration with their teams<span
            class="text-theme-accent font-punctuation">,</span
          > leaders and communities<span
            class="text-theme-accent font-punctuation">.</span
          >
        </h1>
      </div>
    </div>
  </section>

  <!-- Services Cards -->
  <section id="services" class="pt-12 pb-24 px-6 bg-theme-bg">
    <div class="max-w-6xl mx-auto">
      <div class="mb-18">
        <h2 class="heading-section text-theme-main mb-2">
          How can I help you?
        </h2>
        <WavyDivider />
      </div>

      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Cards 1-3 -->
        <ServiceCard title="Strategic planning" icon="lucide:compass">
          Define your strategic vision, priorities and targets, informed by
          contextual analysis and stakeholder input.
        </ServiceCard>

        <ServiceCard
          title="Strategic evaluations and reviews"
          icon="lucide:clipboard-check"
        >
          Develop an evidence-based assessment of your recent successes and
          set-backs, to inform future action.
        </ServiceCard>

        <ServiceCard
          title="Impact definition and measurement"
          icon="lucide:target"
        >
          Strengthen your organisation’s ability to tell the story of its impact
          by defining and measuring change.
        </ServiceCard>

        <!-- Cards 4-6 -->
        <ServiceCard title="Organisational design" icon="lucide:circle-pile">
          Ensure your organisation's structure and capacity are fit-for-purpose
          for delivering your mission and strategy.
        </ServiceCard>

        <ServiceCard title="Board evaluations" icon="lucide:users-round">
          Independent and objective insights to strengthen your Board’s
          leadership, accountability and decision-making.
        </ServiceCard>

        <ServiceCard
          title="Governance reviews and upgrades"
          icon="lucide:clipboard-list"
        >
          Identify opportunities to strengthen your governance policies,
          practices and structures towards best practice.
        </ServiceCard>

        <!-- Cards 7-9 -->

        <ServiceCard
          title="Horizon scanning and market analysis"
          icon="lucide:binoculars"
        >
          Identify emerging trends, risks and opportunities to position you
          for future success.
        </ServiceCard>

        <ServiceCard
          title="Stakeholder and community consultations"
          icon="lucide:message-circle"
        >
          Tailored engagement with your stakeholders to help you understand and
          respond to their needs, experiences and expectations.
        </ServiceCard>

        <ServiceCard
          title="Mentoring and strategic advice"
          icon="lucide:lightbulb"
        >
          One-to-one support for leaders navigating complex organisational
          challenges.
        </ServiceCard>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="pt-12 pb-24 px-6 bg-theme-main">
    <div class="max-w-6xl mx-auto">
      <!-- About Me Header -->
      <div class="mb-18">
        <h2 class="heading-section text-theme-bg mb-2">About me</h2>
        <WavyDivider />
      </div>

      <!-- Constrain with centering -->
      <div class="max-w-5xl mx-auto">
        <!-- Bio with Image -->
        <div class="flex flex-col items-center gap-12">
          <!-- Profile image -->
          <div class="flex flex-col md:flex-row items-center gap-12 text-white">
            <div
              class="flex-shrink-0 w-64 h-64 rounded-full overflow-hidden border-5 border-white"
            >
              <img
                src="/images/luna-portrait.jpg"
                alt="Luna Atkins Romero"
                class="w-full h-full object-cover"
              />
            </div>

            <!-- Quotes + Statement Container -->
            <div class="flex flex-row items-start gap-2">
              <div class="quotes-single text-theme-accent">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 70 54"
                  role="img"
                  aria-hidden="true"
                  ><path
                    d="M68.7 4.614c0 2.16-1.555 4.09-3.734 4.475-3.268.617-6.459 2.006-9.571 4.244-4.28 3.01-6.458 6.714-6.458 11.112 0 4.012 3.812 3.858 6.847 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849-8.949-10.88-5.836-30.635 4.124-39.894 4.746-4.399 10.271-7.1 16.652-8.257 2.723-.54 5.29 1.698 5.29 4.476zm-37.349 0c0 2.16-1.556 4.09-3.735 4.475-3.268.617-6.458 2.006-9.57 4.244-4.28 3.01-6.46 6.714-6.46 11.112 0 4.012 3.813 3.858 6.848 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849C-3.665 37.33-.552 17.577 9.408 8.318 14.154 3.919 19.679 1.218 26.06.06c2.723-.463 5.291 1.775 5.291 4.553z"
                    fill="currentColor"></path></svg
                >
              </div>
              <div>
                <h2 class="font-statement-quotes pr-6">
                  I have dedicated my career to working with and for
                  mission-driven organisations.
                </h2>
              </div>
            </div>
          </div>

          <!-- About text -->
          <div class="max-w-5xl text-white space-y-6">
            <h2 class="font-statement text-xl md:text-2xl">
              Charities, NGOs, social enterprises, research and advocacy
              organisations, and social movements play a vital role in
              championing and addressing people’s needs where the state or the
              economy have failed them. I am passionate about the role of the
              non-profit sector in bringing about social and economic justice,
              and am committed to applying my skills and experience to enable
              them to do so more effectively and efficiently.
            </h2>

            <h2 class="font-statement text-xl md:text-2xl">
              My academic and professional background is in the social sciences,
              particularly equality, gender justice, human rights and
              international development. I’ve worked with individual
              change-makers, organisations and networks spanning a huge
              diversity of social sectors and issues nationally and
              internationally.
            </h2>

            <h2 class="font-statement text-xl md:text-2xl">
              Over the last 20 years, I have garnered 360° lived experience of
              non-profits: as an employee and manager within the sector, as a
              consultant to the sector, and as a Charity Trustee.
            </h2>
          </div>
        </div>

        <!-- Logos Grid -->
        <div class="mt-8 pt-8">
          <div
            class="grid grid-cols-2 md:grid-cols-5 gap-6 items-center justify-items-center"
          >
            <img
              src="/logos/gnb.png"
              alt="GNB"
              class="max-h-16 object-contain opacity-80 hover:opacity-[1] transition-opacity duration-300"
            />
            <img
              src="/logos/unicef.png"
              alt="UNICEF"
              class="max-h-20 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/amnesty.png"
              alt="Amnesty International"
              class="max-h-16 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/kcys.png"
              alt="KCYS"
              class="max-h-24 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
            />
            <img
              src="/logos/goal.png"
              alt="Goal"
              class="max-h-16 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-i-work" class="pt-12 pb-24 px-6 bg-theme-bg">
    <div class="max-w-6xl mx-auto">
      <!-- How I Work Header -->
      <div class="mb-18">
        <h2 class="heading-section text-theme-main mb-2">How I work</h2>
        <WavyDivider />
      </div>

      <!-- Constrain with centering -->
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <HowIWorkItem
            title="Collaborative"
            description="Co-creating solutions alongside teams to ensure ownership and practical outcomes."
            icon="lucide:users"
          />

          <HowIWorkItem
            title="Empowering"
            description="Building capacity, confidence and resilience within organisations."
            icon="lucide:trending-up"
          />

          <HowIWorkItem
            title="Analytical"
            description="Evidence-led insight that informs practical strategy and decision-making."
            icon="lucide:bar-chart"
          />

          <HowIWorkItem
            title="Candid"
            description="Honest, clear guidance rooted in real-world experience."
            icon="lucide:message-circle"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="pt-12 pb-24 px-6 bg-theme-bg">
    <div class="max-w-6xl mx-auto">
      <!-- Testimonials Header -->
      <div class="mb-18">
        <h2 class="heading-section text-theme-main mb-2">Testimonials</h2>
        <WavyDivider />
      </div>

      <!-- Testimonials Grid - Responsive -->
      <div
        class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        <TestimonialCard
          quote="Working with Luna transformed our organization's approach to strategic planning. Her insight and collaborative style brought our team together in ways we hadn't experienced before."
          name="Jane Doe"
          title="Executive Director, Sample Charity"
          initials="JD"
        />

        <TestimonialCard
          quote="Luna's analytical approach combined with her deep understanding of the non-profit sector provided exactly the guidance we needed during a critical transition period."
          name="Michael Smith"
          title="Chair, Example Foundation"
          initials="MS"
        />

        <TestimonialCard
          quote="Her candid feedback and empowering methodology helped our team build the confidence and capacity we needed to take our mission to the next level."
          name="Aisha Johnson"
          title="CEO, Community Impact Group"
          initials="AJ"
        />
      </div>
    </div>
  </section>

  <!-- Contact / Footer -->
  <Footer />
</DefaultLayout>
