---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from "../components/Header.astro";
import WavyDivider from "../components/WavyDivider.astro";
import VerticalWavyDivider from "../components/VerticalWavyDivider.astro";
import ServiceCard from "../components/ServiceCard.astro";
import HowIWorkItem from "../components/HowIWorkItem.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import Footer from "../components/Footer.astro";

import { Icon } from "astro-icon/components";

import { Image } from "astro:assets";
import luna from "../assets/images/luna-portrait-framed.webp";
import logoGNB from "../assets/logos/gnb.png";
import logoUnicef from "../assets/logos/unicef.png";
import logoAmnesty from "../assets/logos/amnesty.png";
import logoKCYS from "../assets/logos/kcys.png";
import logoGOAL from "../assets/logos/goal.png";
---

<DefaultLayout>
  <!-- Navbar + Hero - Full viewport -->
  <section
    id="hero"
    class="min-h-screen bg-theme-bg-primary-blue text-theme-text-light flex flex-col"
  >
    <!-- Header -->
    <Header />

    <!-- Hero -->
    <div class="flex-grow flex items-center px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="hero-section text-theme-text-light">
          Strengthening
          <span class="word-unit">
            non<span class="text-theme-accent font-punctuation">-</span>profits
          </span>
          in collaboration with their
          <span class="word-unit">
            teams<span class="text-theme-accent font-punctuation">,</span>
          </span>
          leaders and
          <span class="word-unit">
            communities<span class="text-theme-accent font-punctuation-oversize"
              >.</span
            >
          </span>
        </h1>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section id="intro" class="bg-theme-bg-neutral1">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:pt-12">
        <!-- Left: Image + Statement -->
        <div
          class="w-full md:w-1/2 px-6 pt-8 md:py-12 flex justify-start md:justify-end items-center"
        >
          <div class="max-w-xl w-full md:pr-20">
            <div class="w-56 sm:w-64 md:w-72 mx-auto md:ml-auto md:mr-0">
              <Image
                src={luna}
                alt="Luna Atkins Romero Portrait"
                width={512}
                height={494}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Horizontal Divider (mobile only) -->
        <div class="md:hidden py-8 px-6">
          <div class="pr-4 md:pr-12">
            <WavyDivider />
          </div>
        </div>

        <!-- Vertical Divider (desktop only) -->
        <div class="hidden md:flex justify-center">
          <div>
            <VerticalWavyDivider height={600} />
          </div>
        </div>

        <!-- Right: statement + Buttons -->
        <div
          class="w-full md:w-1/2 px-6 pb-8 md:py-16 flex justify-start items-center"
        >
          <div class="max-w-xl w-full md:pl-4 text-theme-text-dark space-y-6">
            <h2 class="heading-section text-theme-text-dark mb-12">
              I have dedicated my career to working with and for mission<span
                class="text-theme-accent font-punctuation">-</span
              >driven
              <span class="word-unit">
                organisations<span
                  class="text-theme-accent font-punctuation-oversize">.</span
                >
              </span>
            </h2>

            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 mt-8">
              <a
                href="#about"
                class="action-button text-lg text-theme-text-dark border-theme-bg-primary-blue bg-transparent hover:bg-theme-accent"
              >
                About me
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <a
                href="/contact"
                class="action-button text-lg text-theme-bg-primary-blue border-theme-bg-primary-blue bg-transparent hover:bg-theme-accent"
              >
                Contact me
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section
    id="testimonials"
    class="pb-12 md:pt-12 md:pb-24 px-6 bg-theme-bg-neutral1"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Testimonials Grid - Responsive -->
      <div
        class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 items-stretch"
      >
        <TestimonialCard
          quote="The Board, staff team and community loved working with Luna on our Strategic Plan. She made us feel comfortable and guided us through the process, and kept us focused and on track. It was a pleasure to work with Luna and I would highly recommend her."
          name="Jackie Landers"
          title="CEO, Listowel Family & Community Resource Centre"
          initials="JL"
          color="var(--color-theme-accent)"
        />

        <TestimonialCard
          quote="Luna is extremely skilled at facilitating strategic planning with organisations and groups. I found her openness, perceptiveness and keen insights invaluable throughout. With her support, we achieved a strategic plan that was both ambitious and realisable. No mean feat !!"
          name="Berni Smyth"
          title="Former CEO, Kerry Community Youth Service"
          initials="BS"
          color="var(--color-theme-accent)"
        />
      </div>
    </div>
  </section>

  <!-- Services Cards -->
  <section id="services" class="pt-12 pb-32 px-6 bg-theme-bg-primary-blue">
    <div class="max-w-6xl mx-auto">
      <div class="mb-18">
        <h2 class="heading-section text-theme-text-light">
          How can I help you?
        </h2>
        <WavyDivider color={"var(--color-theme-accent)"} />
        <!--  -->
      </div>

      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Cards 1-3 -->
        <ServiceCard title="Strategic planning" icon="lucide:compass">
          Define your strategic vision, priorities and targets, informed by
          contextual analysis and stakeholder input.
        </ServiceCard>

        <ServiceCard
          title="Strategic evaluations and reviews"
          icon="lucide:clipboard-check"
        >
          Develop an evidence-based assessment of your recent successes and
          set-backs, to inform future action.
        </ServiceCard>

        <ServiceCard
          title="Impact definition and measurement"
          icon="lucide:target"
        >
          Strengthen your organisation’s ability to tell the story of its impact
          by defining and measuring change.
        </ServiceCard>

        <!-- Cards 4-6 -->
        <ServiceCard title="Organisational design" icon="lucide:circle-pile">
          Ensure your organisation's structure and capacity are fit-for-purpose
          for delivering your mission and strategy.
        </ServiceCard>

        <ServiceCard title="Board evaluations" icon="lucide:users-round">
          Independent and objective insights to strengthen your Board’s
          leadership, accountability and decision-making.
        </ServiceCard>

        <ServiceCard
          title="Governance reviews and upgrades"
          icon="lucide:clipboard-list"
        >
          Identify opportunities to strengthen your governance policies,
          practices and structures towards best practice.
        </ServiceCard>

        <!-- Cards 7-9 -->

        <ServiceCard
          title="Horizon scanning and market analysis"
          icon="lucide:binoculars"
        >
          Identify emerging trends, risks and opportunities to position you for
          future success.
        </ServiceCard>

        <ServiceCard
          title="Stakeholder and community consultations"
          icon="lucide:message-circle"
        >
          Tailored engagement with your stakeholders to help you understand and
          respond to their needs, experiences and expectations.
        </ServiceCard>

        <ServiceCard
          title="Mentoring and strategic advice"
          icon="lucide:lightbulb"
        >
          One-to-one support for leaders navigating complex organisational
          challenges.
        </ServiceCard>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="flex flex-col md:flex-row">
      <!-- Left: Heading -->
      <div
        class="md:w-1/2 bg-theme-bg-alt1-green px-6 pt-8 md:py-16 flex justify-start md:justify-end items-start"
      >
        <div class="max-w-xl w-full md:pr-4">
          <h2
            class="heading-section text-theme-text-dark md:text-right no-mb no-mt"
          >
            I am passionate about the role of the non<span
              class="text-theme-accent-coral">-</span
            >profit sector in bringing about social and economic justice<span
              class="text-theme-accent-coral font-oversize">.</span
            >
          </h2>
        </div>
      </div>

      <!-- Horizontal Divider (mobile only) -->
      <div class="md:hidden py-8 px-6 bg-theme-bg-alt1-green">
        <div class="pr-4 md:pr-12">
          <WavyDivider color="var(--color-theme-accent-coral)" />
        </div>
      </div>

      <!-- Vertical Divider (desktop only) -->
      <div class="hidden md:flex items-stretch py-12 bg-theme-bg-alt1-green">
        <VerticalWavyDivider
          color="var(--color-theme-accent-coral)"
          ,
          height={700}
        />
      </div>

      <!-- Right: Content -->
      <div
        class="md:w-1/2 bg-theme-bg-alt1-green px-6 pb-8 md:py-16 flex justify-start items-start"
      >
        <div
          class="about-content max-w-xl w-full md:pl-4 text-theme-text-dark space-y-6"
        >
          <p class="about-para md: no-mt about-para-bullet">
            Charities, NGOs, social enterprises, research and advocacy
            organisations, and social movements play a vital role in championing
            and addressing people's needs where the state or the economy have
            failed them. <span class="text-theme-text-alt-dark para-emphasis"
              >I am committed to applying my skills and experience to enable
              them to do so more effectively and efficiently</span
            >.
          </p>

          <p class="about-para about-para-bullet">
            My academic and professional background is in the social sciences,
            particularly equality, gender justice, human rights and
            international development. <span
              class="text-theme-text-alt-dark para-emphasis"
              >I've worked with individual change-makers, organisations and
              networks spanning a huge diversity of social sectors and issues
              nationally and internationally</span
            >.
          </p>

          <p class="about-para no-mb about-para-bullet">
            <span class="text-theme-text-alt-dark para-emphasis"
              >Over the last 20 years, I have garnered 360° lived experience of
              non-profits</span
            >: as an employee and manager within the sector, as a consultant to
            the sector, and as a Charity Trustee.
          </p>
        </div>
      </div>

      <!-- Horizontal Divider (mobile only) -->
      <div class="md:hidden pb-8 px-6 bg-theme-bg-alt1-green">
        <div class="pr-4 md:pr-12">
          <WavyDivider color="var(--color-theme-accent-coral)" />
        </div>
      </div>
    </div>
  </section>

 <!-- How I work -->
<section id="how-i-work" class="md:pb-12 bg-theme-bg-alt1-green">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section Heading -->
    <h2 class="heading-section text-center text-theme-text-dark no-mb">
      How I work:
    </h2>

    <!-- Cards Grid -->
    <div class="flex flex-row gap-6 md:gap-8 mt-8 justify-center items-start">
      <div class="work-card">
        <h3 class="work-card-title word-unit">
          <span class="work-moon"></span>Collaborative
        </h3>
        <p class="work-para">
          Co-creating solutions alongside teams to ensure ownership and
          practical outcomes.
        </p>
      </div>

      <div class="work-card">
        <h3 class="work-card-title word-unit">
          <span class="work-moon"></span>Empowering
        </h3>
        <p class="work-para">
          Building capacity, confidence, and resilience within organisations.
        </p>
      </div>

      <div class="work-card">
        <h3 class="work-card-title word-unit">
          <span class="work-moon"></span>Analytical
        </h3>
        <p class="work-para">
          Evidence-led insight that informs practical strategy and
          decision-making.
        </p>
      </div>

      <div class="work-card">
        <h3 class="work-card-title word-unit">
          <span class="work-moon"></span>Candid
        </h3>
        <p class="work-para">
          Honest, clear guidance rooted in real-world experience.
        </p>
      </div>
    </div>

      <div class="mt-8 mb-8">
        <WavyDivider color="var(--color-theme-accent-coral)" />
      </div>

      <div class="flex justify-center pt-8 pb-8">
        <a
          href="/contact"
          class="action-button text-lg text-theme-bg-primary-blue border-theme-bg-primary-blue bg-transparent hover:bg-theme-accent-coral"
        >
          Contact me
             <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Logos Section -->
  <section id="logo-reel" class="pt-12 px-6 bg-theme-bg-primary-blue">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <h2
          class="font-statement-subtle text-center text-theme-text-light mb-8 text-lg"
        >
          A sample of the organisations I've worked with:
        </h2>
      </div>

      <div
        class="grid grid-cols-2 md:grid-cols-5 gap-8 items-center justify-items-center"
      >
        <a
          href="https://www.girlsnotbrides.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="work-logo-link"
        >
          <Image
            src={logoGNB}
            alt="Girls not Brides Charity Logo"
            class="work-logo max-h-12 object-contain transition-all"
          />
        </a>

        <a
          href="https://www.unicef.org.uk/"
          target="_blank"
          rel="noopener noreferrer"
          class="work-logo-link"
        >
          <Image
            src={logoUnicef}
            alt="UNICEF UK Charity Logo"
            class="work-logo max-h-16 object-contain transition-all"
          />
        </a>

        <a
          href="https://www.amnesty.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="work-logo-link"
        >
          <Image
            src={logoAmnesty}
            alt="Amnesty International Charity Logo Banner"
            class="work-logo max-h-12 object-contain transition-all"
          />
        </a>

        <a
          href="https://www.kcys.ie/"
          target="_blank"
          rel="noopener noreferrer"
          class="work-logo-link"
        >
          <Image
            src={logoKCYS}
            alt="Kerry Community Youth Services Charity Logo"
            class="work-logo max-h-20 object-contain transition-all"
          />
        </a>

        <a
          href="https://www.goalglobal.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="work-logo-link"
        >
          <Image
            src={logoGOAL}
            alt="GOAL Charity Logo"
            class="work-logo max-h-12 object-contain transition-all"
          />
        </a>
      </div>
      <div class="mt-12">
        <WavyDivider />
      </div>
    </div>
  </section>

  <!-- Contact / Footer -->
  <Footer />
</DefaultLayout>
