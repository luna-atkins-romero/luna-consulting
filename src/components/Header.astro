---
import Brand from "./Brand.astro";
import LinkedInIcon from "./LinkedInIcon.astro";
import Navigation from "./Navigation.astro";

const currentPath = new URL(Astro.request.url).pathname;
const isHomepage = currentPath === "/";
---

<header class="py-8 px-6 bg-theme-bg-primary-blue text-theme-text-light">
    <!-- Skip link - first focusable element -->
    <a href="#main-content" class="skip-link"> Skip to main content </a>
    <div class="max-w-6xl mx-auto flex items-baseline justify-between">
        <!-- Brand -->
        <Brand showCircle={true} />
        <!-- Nav -->
        <Navigation>
            <li>
                <a href={isHomepage ? "#services" : "/#services"}> Services </a>
            </li>
            <li>
                <a href={isHomepage ? "#about" : "/#about"}> About </a>
            </li>
            <li><a href="/articles">Articles</a></li>
            <li><a href="/contact">Contact</a></li>
            <li>
                <a
                    href="https://www.linkedin.com/in/lunaatkinsromero/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn profile"
                    class="linkedin-link inline-flex items-center"
                    aria-label="LinkedIn profile (opens in new tab)"
                >
                    <LinkedInIcon class="w-4.5 h-4.5" />
                </a>
            </li>
        </Navigation>
    </div>
</header>
