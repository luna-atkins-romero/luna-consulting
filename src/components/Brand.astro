---
import MoonIcon from "./MoonIcon.astro";

const currentPath = new URL(Astro.request.url).pathname;
const isHomePage = currentPath === "/";
---
<div class="flex flex-col items-start gap-0 relative">

 <a
    href="/"
    aria-current={isHomePage ? "page" : undefined}
    class="brand-link"
  >
  <div class="brand-full-logo flex items-center">
    <div class="brand-logo">
      <MoonIcon phase="waning" class="brand-moon-svg" aria-hidden="true" />
    </div>

    <div class="brand-text">
      <div
        class="font-brand text-theme-text-light brand-heading"
      >
        <span class="brand-name">Luna</span> <span class="hidden xl:inline">Atkins Romero</span>
      </div>

      <div class="font-brand text-theme-text-light brand-heading">
          <span class="word-unit">
            <span class="brand-name">Consulting</span><span
              class="font-punctuation-oversize text-theme-accent"
              aria-hidden="true">.</span
            >
          </span>
        </div>
    </div>
  </div>
</a>