---
interface Props {
  showLogo?: boolean;
}
const { showLogo = false } = Astro.props;
---

<div class="flex flex-col items-start gap-0">
  {showLogo && (
    <span class="material-symbols-outlined text-5xl md:text-6xl">nightlight</span>
  )}
  <h1 class="font-brand text-5xl md:text-6xl leading-tight">
    Luna Atkins Romero
  </h1>
  <h2 class="font-brand text-2xl md:text-3xl text-blue-light">
    Consulting
  </h2>
</div>
