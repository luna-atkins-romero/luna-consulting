---
interface Props {
  showLogo?: boolean;
}
const { showLogo = false } = Astro.props;

const currentPath = new URL(Astro.request.url).pathname;
const isHomePage = currentPath === "/";
---

<div class="flex flex-col items-start gap-0">
  <a href="/" aria-current={isHomePage ? "page" : undefined} class="brand-link">
    {showLogo && (
      <span class="material-symbols-outlined text-5xl md:text-6xl">
        nightlight
      </span>
    )}
    
    <h1 class="font-brand text-theme-text-light text-3xl lg:text-4xl leading-tight brand-heading">
      Luna Atkins Romero
    </h1>
    
    <h2 class="font-brand text-theme-text-light text-2xl lg:text-3xl brand-heading">
      Consulting<span class="font-punctuation text-theme-accent text-4xl lg:text-5xl" style="line-height:0;">.</span>
    </h2>
  </a>
</div>