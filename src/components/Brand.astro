---
interface Props {
  showCircle?: boolean;
  lunaColor?: string;
}

const { showCircle = false, lunaColor = "var(--color-theme-text-dark)" } =
  Astro.props;

const currentPath = new URL(Astro.request.url).pathname;
const isHomePage = currentPath === "/";
---

<div class="flex flex-col items-start gap-0 relative overflow-visible">
  <a href="/" aria-current={isHomePage ? "page" : undefined} class="brand-link">
    <!-- Circle - using z-base (0) so it stays visible but behind text -->
    {
      showCircle && (
        <span
          class="absolute rounded-full bg-theme-accent opacity-80"
          style="width: 20em; height: 20em; top: -8em; left: -4.55em; z-index: var(--z-base);"
        />
      )
    }

    <div class="brand-text">
      <h1
        class="font-brand text-theme-text-light text-3xl lg:text-4xl brand-heading"
      >
        <span
          class="font-punctuation"
          style="font-size: 1.1em;">L</span
        ><span style="font-size: 1.1em;">una Atkins Romero </span>
      </h1>

      <h2
        class="font-brand text-theme-text-light text-2xl lg:text-3xl brand-heading"
      >
        Consulting<span
          class={`font-punctuation-oversize ${showCircle ? "text-theme-text-dark" : "text-theme-accent"}`}
          >.</span
        >
      </h2>
    </div>
  </a>
</div>
