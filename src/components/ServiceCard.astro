---
/**
 * ServiceCard Component
 *
 * @description A reusable card component for displaying services
 * with a drop shadow effect
 */

import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  icon?: string;
}

const { title = "Service Title", icon = "lucide:star" }: Props = Astro.props;
---

<div class="service-card">
  <div class="service-card-inner">
    {
      icon && (
        <div class="icon-circle">
          <Icon aria-hidden="true" name={icon} class="icon-svg" />
        </div>
      )
    }
    <h4 class="service-card-title">{title}</h4>
    <div class="service-card-content">
      <slot><p>Default content goes here</p></slot>
    </div>
  </div>
</div>

<style lang="scss">
  .service-card {
    position: relative;
    padding: 1.5rem;
    inline-size: calc(100% - 1.5rem);

    > * {
      position: relative;
      z-index: 2;
    }

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      border: 3px solid var(--color-theme-main);
      border-radius: 0.5rem;
      background-color: white;
      box-shadow: 0 0 0 6px white;
    }

    &::after {
      content: "";
      position: absolute;
      inset: 1rem -0.85rem -0.85rem 1rem;
      z-index: 0;
      border-radius: 0.5rem;
      background-color: var(--color-theme-accent);
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }

    &:hover::after {
      opacity: 0.4;
    }
  }

  .service-card-inner {
    position: relative;
    z-index: 2;
    padding: 2rem;
  }

  .icon-circle {
    width: 3.5rem; /* circle size */
    height: 3.5rem;
    border-radius: 9999px; /* full circle */
    background-color: rgba(100, 151, 177, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 0.75rem;
    transition: transform 0.3s ease;
  }

  .service-card:hover .icon-circle {
    transform: scale(1.1);
  }

  .icon-svg {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-blue-green); /* icon color */
  }

  .service-card-title {
    margin-bottom: 0.75rem;
    line-height: 1.3;
    font-size: large;
    color: var(--color-theme-main); /* icon color */
  }

  .service-card-content {
    font-family: "Montserrat Variable", sans-serif;
    font-weight: 500;
    font-style: normal;
    line-height: 1.6;
    margin: 0;
  }
</style>