<nav aria-label="Primary navigation" class="relative font-nav">
  <!-- Toggle button (mobile only) -->
  <button
    id="nav-toggle"
    aria-expanded="false"
    aria-controls="primary-menu"
    aria-label="Toggle navigation"
    class="md:hidden
      flex items-center justify-center
      w-10 h-10
      rounded
      focus-visible:outline
      focus-visible:outline-2
      focus-visible:outline-light
    text-theme-bg-neutral1 hover:text-theme-accent
      transition-colors"
  >
    <span class="sr-only">Menu</span>

    <!-- Hamburger icon (inherit color from button) -->
    <svg
      class="nav-icon nav-icon--open w-6 h-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"   
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>

    <!-- Close icon -->
    <svg
      class="nav-icon nav-icon--close hidden w-6 h-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Menu -->
  <ul
    id="primary-menu"
    class="hidden
      absolute right-0 top-full mt-4
      flex flex-col gap-4
      px-6 py-6
      text-right
      bg-theme-bg-primary-blue
      md:static md:flex
      md:flex-row md:gap-6 lg:gap-12
      md:border-0 md:p-0
      md:text-left md:items-center"
  >
    <slot />
  </ul>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('primary-menu');

  if (toggle instanceof HTMLButtonElement && menu) {
    const openIcon = toggle.querySelector('.nav-icon--open');
    const closeIcon = toggle.querySelector('.nav-icon--close');

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';

      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');

      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });
  }
</script>
