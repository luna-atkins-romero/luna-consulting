---
// Testimonials.astro (section component)
import TestimonialCard from './TestimonialCard.astro';
---

<section id="testimonials" class="pt-12 pb-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Testimonials Header -->
    <div class="mb-18">
      <h2 class="font-headline text-dusk-blue mb-2">Testimonials</h2>

      <!-- Wavy Divider -->
      <svg
        class="w-full h-2 mb-12"
        viewBox="0 0 1200 12"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,6 Q10,0 20,6 T40,6 T60,6 T80,6 T100,6 T120,6 T140,6 T160,6 T180,6 T200,6 T220,6 T240,6 T260,6 T280,6 T300,6 T320,6 T340,6 T360,6 T380,6 T400,6 T420,6 T440,6 T460,6 T480,6 T500,6 T520,6 T540,6 T560,6 T580,6 T600,6 T620,6 T640,6 T660,6 T680,6 T700,6 T720,6 T740,6 T760,6 T780,6 T800,6 T820,6 T840,6 T860,6 T880,6 T900,6 T920,6 T940,6 T960,6 T980,6 T1000,6 T1020,6 T1040,6 T1060,6 T1080,6 T1100,6 T1120,6 T1140,6 T1160,6 T1180,6 T1200,6"
          stroke="currentColor"
          stroke-width="4"
          fill="none"
          class="text-green-aqua"></path>
      </svg>
    </div>

    <!-- Testimonials Grid - Responsive -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <TestimonialCard
        quote="Working with Luna transformed our organization's approach to strategic planning. Her insight and collaborative style brought our team together in ways we hadn't experienced before."
        name="Jane Doe"
        title="Executive Director, Sample Charity"
        initials="JD"
      />

      <TestimonialCard
        quote="Luna's analytical approach combined with her deep understanding of the non-profit sector provided exactly the guidance we needed during a critical transition period."
        name="Michael Smith"
        title="Chair, Example Foundation"
        initials="MS"
      />

      <TestimonialCard
        quote="Her candid feedback and empowering methodology helped our team build the confidence and capacity we needed to take our mission to the next level."
        name="Aisha Johnson"
        title="CEO, Community Impact Group"
        initials="AJ"
      />
    </div>
  </div>
</section>