---
// Footer.astro
import Brand from './Brand.astro';
import LinkedInIcon from './LinkedInIcon.astro';
import WavyDivider from './WavyDivider.astro';

const currentYear = new Date().getFullYear();
---
<footer class="bg-theme-bg-primary-blue text-theme-text-light py-12 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Main Footer Content -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-12 mb-8">
      <!-- Brand & Description -->
      <div>
        <Brand />
      </div>

      <!-- Quick Links & Connect grouped on right -->
      <div class="grid grid-cols-1 md: grid-cols-2 gap-12">
        <!-- Quick Links -->
        <div>
          <div class="mb-2">  
            <h4 class="mb-4 text-theme-accent">Quick Links</h4>
          </div>
          
          <nav aria-label="Footer navigation">
            <ul class="font-nav space-y-4">
              <li>
                <a href="#services" class="text-theme-text-light">
                  Services
                </a>
              </li>
              <li>
                <a href="#about" class="text-theme-text-light">
                  About
                </a>
              </li>
              <li>
                <a href="#how-i-work" class="text-theme-text-light">
                  How I Work
                </a>
              </li>
              <li>
                <a href="#testimonials" class="text-theme-text-light">
                  Testimonials
                </a>
              </li>
              <li>
                <a href="/articles" class="text-theme-text-light">
                  Articles
                </a>
              </li>
              <li>
                <a href="/contact" class="text-theme-text-light">
                  Contact
                </a>
              </li>
            </ul>
          </nav>
        </div>

        <!-- Connect & Sustainability -->
        <div>
          <div class="mb-2">
            <h4 class="mb-4 text-theme-accent">Connect</h4>
          </div>
          
           <a
                    href="https://www.linkedin.com/in/lunaatkinsromero/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn profile"
                    class="linkedin-link inline-flex items-center"
                >
                    <LinkedInIcon class="w-4 h-4" />
                </a>
          

          <div class="mt-6">
            <div class="mb-2">
              <h4 class=" text-theme-accent">Accountability</h4>
            </div>
            
            <ul class="font-nav space-y-4">
              <li>
                <a
                  href="https://www.websitecarbon.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link text-theme-text-light flex items-start gap-2"
                >
                  <span>Low Carbon Website</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.w3.org/WAI/standards-guidelines/wcag/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link text-theme-text-lightflex items-start gap-2"
                >

                  <span>WCAG Compliant</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8">
      <div class="mb-8">
        <WavyDivider />
      </div>
        
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-theme-text-light">
        
        <p>
          © {currentYear} Luna Atkins Romero Consulting.  All rights reserved.
        </p>
        <p>
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-theme-accent transition-colors">Astro</a>.
        </p>
      </div>
    </div>
  </div>
</footer>