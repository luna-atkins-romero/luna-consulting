---
// Footer.astro
import Brand from './Brand.astro';
import SocialLinks from "../components/SocialLinks.astro";
import WavyDivider from './WavyDivider.astro';

const currentYear = new Date().getFullYear();
---
<footer class="bg-dusk-blue text-white py-12 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Main Footer Content -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-12 mb-8">
      <!-- Brand & Description -->
      <div>
        <Brand showLogo={false} />
      </div>

      <!-- Quick Links & Connect grouped on right -->
      <div class="grid grid-cols-1 md: grid-cols-2 gap-12">
        <!-- Quick Links -->
        <div>
          <h4 class="mb-4 text-green-aqua">Quick Links</h4>
          <nav aria-label="Footer navigation">
            <ul class="font-nav space-y-2">
              <li>
                <a href="#services" class="text-white">
                  Services
                </a>
              </li>
              <li>
                <a href="#about" class="text-white">
                  About
                </a>
              </li>
              <li>
                <a href="#how-i-work" class="text-white">
                  How I Work
                </a>
              </li>
              <li>
                <a href="#testimonials" class="text-white">
                  Testimonials
                </a>
              </li>
              <li>
                <a href="/blog" class="text-white">
                  Articles
                </a>
              </li>
              <li>
                <a href="/contact" class="text-white">
                  Contact
                </a>
              </li>
            </ul>
          </nav>
        </div>

        <!-- Connect & Sustainability -->
        <div>
          <h4 class="mb-4 text-green-aqua">Connect</h4>
          <SocialLinks />

          <div class="mt-6">
            <h4 class="mb-4 text-green-aqua">Sustainability</h4>
            <ul class="font-nav space-y-2">
              <li>
                <a
                  href="https://www.websitecarbon.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:text-green-aqua transition-colors duration-300 flex items-start gap-2"
                >
                  <span>Low Carbon Website</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.w3.org/WAI/standards-guidelines/wcag/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:text-green-aqua transition-colors duration-300 flex items-start gap-2"
                >

                  <span>WCAG Compliant</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8">
        <WavyDivider />
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white">
        
        <p>
          © {currentYear} Luna Atkins Romero Consulting.  All rights reserved.
        </p>
        <p>
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-green-aqua transition-colors">Astro</a> • 
          Designed for accessibility and sustainability
        </p>
      </div>
    </div>
  </div>
</footer>