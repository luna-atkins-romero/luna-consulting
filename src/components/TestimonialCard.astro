---
// TestimonialCard.astro
interface Props {
  quote: string;
  name: string;
  title: string;
  initials: string;
  color?: string; // Make optional since we're using theme colors
}

const { quote, name, title, initials, color } = Astro.props;
---

<figure class="flex flex-col justify-between h-full py-4">
  <!-- Quote content -->
  <blockquote>
    <div class="quotes-single w-12 mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 70 54"
        aria-hidden="true"
      >
        <path d="..." fill={color || "var(--color-theme-accent-coral)"} />
      </svg>
    </div>

    <p class="text-theme-text-dark-contrast italic">
      {quote}
    </p>
  </blockquote> 

  <!-- Attribution -->
  <figcaption class="flex items-center gap-3 mt-6">
    <div class="icon-circle no-mb" aria-hidden="true">
      <span class="text-theme-accent-coral font-semibold text-sm">{initials}</span>
    </div>
    <div>
      <p class="para-emphasis text-theme-text-dark no-mb">{name}</p>
      <p class="text-theme-text-grey no-mb">{title}</p>
    </div>
  </figcaption>
</figure>