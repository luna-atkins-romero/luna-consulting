---
// TestimonialCard.astro
interface Props {
  quote: string;
  name: string;
  title: string;
  initials: string;
  color: string;
}

const { quote, name, title, initials, color } = Astro.props;
---

<div class="flex flex-col justify-between h-full py-4">

  <!-- Top section: Quote mark + Quote text -->
  <div>
    <!-- Quote mark -->
    <div class="quotes-single w-12 mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 70 54"
        role="img"
        aria-hidden="true"
      >
        <path
          d="M68.7 4.614c0 2.16-1.555 4.09-3.734 4.475-3.268.617-6.459 2.006-9.571 4.244-4.28 3.01-6.458 6.714-6.458 11.112 0 4.012 3.812 3.858 6.847 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849-8.949-10.88-5.836-30.635 4.124-39.894 4.746-4.399 10.271-7.1 16.652-8.257 2.723-.54 5.29 1.698 5.29 4.476zm-37.349 0c0 2.16-1.556 4.09-3.735 4.475-3.268.617-6.458 2.006-9.57 4.244-4.28 3.01-6.46 6.714-6.46 11.112 0 4.012 3.813 3.858 6.848 3.55 10.738-1.158 17.897 10.262 12.217 19.445-5.447 8.797-19.142 8.41-25.367.849C-3.665 37.33-.552 17.577 9.408 8.318 14.154 3.919 19.679 1.218 26.06.06c2.723-.463 5.291 1.775 5.291 4.553z"
          fill={color}
        />
      </svg>
    </div>

    <!-- Quote text -->
    <p class="text-theme-text-dark-contrast italic">
      {quote}
    </p>
  </div>

  <!-- Bottom section: Author info (always at bottom) -->
  <div class="flex items-center gap-3 mt-6">
    <div class="w-10 h-10 rounded-full bg-blue-green/20 flex items-center justify-center flex-shrink-0">
      <span class="text-blue-green font-semibold text-sm">{initials}</span>
    </div>
    <div>
      <p class="para-emphasis text-theme-text-dark no-mb">{name}</p>
      <p class="text-theme-text-grey no-mb">{title}</p>
    </div>
  </div>
</div>